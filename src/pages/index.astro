---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section class="border-border border-b pt-8 pb-6 text-sm sm:text-base">
      <p class="text-muted-foreground">giho@blog ~ % whoami</p>
      <p class="mb-6">Database Administrator · Data Engineer</p>
      <p>
        <span class="text-prompt">giho=#</span>{" "}
        <span
          id="typed-query"
          data-text="select title, tags, published from posts order by published desc;"
          >select title, tags, published from posts order by published desc;</span
        ><span class="cursor-blink">&nbsp;▊</span>
      </p>
    </section>

    <section class="pt-6 pb-6 text-sm">
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-border text-muted-foreground border-b">
              <th class="py-1 pr-4 font-medium">title</th>
              <th class="py-1 pr-4 font-medium">tags</th>
              <th class="py-1 font-medium">published</th>
            </tr>
          </thead>
          <tbody>
            {
              posts.map(p => (
                <tr class="border-border/60 hover:bg-muted/40 border-b transition-colors">
                  <td class="py-1.5 pr-4 align-top">
                    <a
                      class="text-accent hover:underline"
                      href={getPostUrl(p.id, p.filePath, locale)}
                    >
                      {p.data.title}
                    </a>
                  </td>
                  <td class="text-muted-foreground py-1.5 pr-4 align-top">
                    {p.data.tags?.length ? p.data.tags.join(", ") : "-"}
                  </td>
                  <td class="text-muted-foreground py-1.5 align-top whitespace-nowrap">
                    {fmt(p.data.pubDatetime)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="text-muted-foreground mt-3">({posts.length} rows)</p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // 홈 프롬프트 쿼리 타이핑 — reduced-motion이면 전체 즉시 표시
  function typeQuery() {
    const el = document.getElementById("typed-query");
    if (!el) return;
    const full = el.dataset.text || el.textContent || "";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      el.textContent = full;
      return;
    }
    el.textContent = "";
    let i = 0;
    const tick = () => {
      if (!el.isConnected) return;
      el.textContent = full.slice(0, i);
      if (i++ < full.length) setTimeout(tick, 16);
    };
    tick();
  }

  typeQuery();
  document.addEventListener("astro:after-swap", typeQuery);
</script>
