---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const [lead, ...rest] = posts;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const topTag = (p: (typeof posts)[number]) => p.data.tags?.[0] ?? "";
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- Masthead -->
    <section class="border-border border-b pt-10 pb-8">
      <h1
        class="font-display text-5xl font-semibold tracking-tight sm:text-6xl"
      >
        giho
      </h1>
      <p
        class="text-muted-foreground mt-3 font-mono text-xs tracking-[0.25em] uppercase"
      >
        data · databases · tools
      </p>
    </section>

    <!-- Lead essay -->
    {
      lead && (
        <section class="border-border border-b py-8">
          <p class="text-accent mb-3 font-mono text-xs tracking-widest uppercase">
            Latest
          </p>
          <a
            href={getPostUrl(lead.id, lead.filePath, locale)}
            class="group block"
          >
            <h2 class="font-display group-hover:text-accent text-3xl leading-tight font-semibold tracking-tight transition-colors sm:text-4xl">
              {lead.data.title}
            </h2>
          </a>
          <p class="text-muted-foreground mt-3 font-mono text-xs">
            {fmt(lead.data.pubDatetime)}
            {topTag(lead) && <span> · {topTag(lead)}</span>}
          </p>
          {lead.data.description && (
            <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
              {lead.data.description}
            </p>
          )}
        </section>
      )
    }

    <!-- Index -->
    <section class="py-8">
      <p
        class="text-muted-foreground mb-2 font-mono text-xs tracking-widest uppercase"
      >
        Writing
      </p>
      <ul>
        {
          rest.map(p => (
            <li class="group border-border/60 border-b">
              <a
                href={getPostUrl(p.id, p.filePath, locale)}
                class="flex flex-col py-4 sm:flex-row sm:items-baseline sm:gap-5"
              >
                <time class="text-muted-foreground shrink-0 font-mono text-xs sm:w-24">
                  {fmt(p.data.pubDatetime)}
                </time>
                <span class="font-display group-hover:text-accent text-lg font-medium transition-colors">
                  {p.data.title}
                </span>
                {topTag(p) && (
                  <span class="text-muted-foreground mt-1 font-mono text-[0.7rem] tracking-wider uppercase sm:mt-0 sm:ms-auto">
                    {topTag(p)}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
