---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="404 · not found">
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section class="pt-8 pb-6 text-sm sm:text-base">
      <p>
        <span class="text-prompt">giho=#</span> select * from pages where path = current_path;
      </p>
      <p class="text-muted-foreground mt-4">ERROR: relation for this path does not exist</p>
      <p class="text-muted-foreground">DETAIL: 404 — page not found</p>
      <p class="mt-6">
        <a class="text-accent hover:underline" href="/">\c home</a>
        <span class="text-muted-foreground">-- 홈으로 돌아가기</span>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
