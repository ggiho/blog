---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="404 · not found">
  <Header />
  <main id="main-content" class="app-layout">
    <section class="py-16">
      <p class="text-accent mb-3 font-mono text-xs tracking-widest uppercase">
        Error 404
      </p>
      <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        여긴 아무것도 없어요
      </h1>
      <p class="text-muted-foreground mt-4 text-lg">
        주소가 바뀌었거나 사라진 페이지입니다.
      </p>
      <p class="mt-8 font-mono text-sm">
        <a class="text-accent hover:underline" href="/">← 홈으로 돌아가기</a>
      </p>
    </section>
  </main>
  <Footer />
</Layout>
