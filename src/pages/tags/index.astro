---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const counts = new Map<string, number>();
for (const p of posts)
  for (const tag of p.data.tags ?? [])
    counts.set(tag.toLowerCase(), (counts.get(tag.toLowerCase()) ?? 0) + 1);
---

<Layout title={`Tags | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b pt-10 pb-6">
      <h1 class="font-display text-4xl font-semibold tracking-tight">Tags</h1>
      <p class="text-muted-foreground mt-2 font-mono text-xs tracking-wider">
        {tags.length} topics
      </p>
    </section>

    <section class="py-6">
      <ul class="flex flex-col">
        {
          tags.map(({ tag, tagName }) => (
            <li class="group border-border/60 border-b">
              <a
                href={`/tags/${tag}/`}
                class="flex items-baseline justify-between py-3"
              >
                <span class="font-display group-hover:text-accent text-lg transition-colors">
                  #{tagName}
                </span>
                <span class="text-muted-foreground font-mono text-xs">
                  {counts.get(tag.toLowerCase()) ?? 0}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
