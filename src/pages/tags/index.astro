---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const counts = new Map<string, number>();
for (const p of posts)
  for (const tag of p.data.tags ?? [])
    counts.set(tag.toLowerCase(), (counts.get(tag.toLowerCase()) ?? 0) + 1);
---

<Layout title={`Tags | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section class="pt-8 pb-6 text-sm sm:text-base">
      <ul>
        {
          tags.map(({ tag, tagName }) => (
            <li class="border-border/60 hover:bg-muted/40 -mx-2 border-b px-2 transition-colors">
              <a
                href={`/tags/${tag}/`}
                class="flex items-baseline justify-between py-2.5"
              >
                <span class="text-accent hover:underline">#{tagName}</span>
                <span class="text-muted-foreground text-xs">
                  {counts.get(tag.toLowerCase()) ?? 0}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
